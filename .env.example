# ---------------------------------------------------------------------------
# Axon Voice — environment configuration
# Copy to `.env` and fill in. `.env` is git-ignored.
#
# ASSEMBLYAI_API_KEY is what Axon needs to hold a spoken conversation.
# Without it Axon still runs — the window, dispatcher, tools, browser and Tool
# Console all work with no keys configured — but it cannot hold a spoken
# conversation, and it says so in the window. Everything else is optional.
# ---------------------------------------------------------------------------

# --- Voice agent -----------------------------------------------------------
# AssemblyAI API key. This is the one Axon actually needs.
#
# It powers the whole spoken path: speech recognition, the reasoning model and
# the synthesised voice all come from AssemblyAI's Voice Agent API over one
# WebSocket. Without it Axon still runs — the window, the timeline, the
# dispatcher, the browser and every tool work — but it cannot hold a
# conversation, and it says so above the composer.
#
# Read ONLY by the main process (src/main/runtime.ts), into a local that is
# handed straight to the factory. It is never placed on RuntimeConfig, never
# sent over IPC, never reaches the renderer, and never appears in an event, a
# log, a snapshot or an error message. `listening-security.test.ts` asserts all
# of that against the source tree.
ASSEMBLYAI_API_KEY=

# Voice agent provider: assemblyai (default) | none
# A NAME, never a URL. There is deliberately no configuration that points
# Axon's microphone at a different endpoint.
AXON_VOICE_AGENT_PROVIDER=assemblyai

# --- Agent brain (typed conversation only) ---------------------------------
# Anthropic API key. OPTIONAL, and not used by the spoken path at all.
# Without it, typing to Axon has no brain attached; speaking to it still works.
# Read only by the main process (src/main/runtime.ts), under the same rules as
# the key above.
ANTHROPIC_API_KEY=
# Model id. Do not append a date suffix.
# Must be a model that accepts adaptive thinking (Opus 4.6+ / Sonnet 4.6+).
AXON_MODEL=claude-opus-5

# --- Voice out (Step 3) ----------------------------------------------------
# Text-to-speech provider: sapi (offline Windows, no key) | none
# SAPI needs no key, no network and no account. Set to `none` to keep Axon
# silent; it still shows every reply in the transcript.
AXON_TTS_PROVIDER=sapi

# --- Local recognizer (wake word, and typed-fallback voice input) ----------
# Speech-to-text provider: windows (offline, no key) | none
#
# `windows` uses System.Speech.Recognition, which ships with Windows. It needs
# no key, no account, no model download and no network.
#
# This transcribes push-to-talk. It is NOT what listens for the wake phrase any
# more; see AXON_WAKE_ENGINE below. Setting it to `none` turns off voice input.
AXON_STT_PROVIDER=windows

# Which engine listens for the wake phrase. `keyword` (the default) is a
# dedicated local keyword spotter that needs `npm run wake:model` once;
# `windows` is the original speech recognizer, kept as the control arm for
# measurements; `none` disables the wake word entirely, and the hotkey and the
# on-screen button still start a conversation.
#
# Whichever is armed, this is what listens for "Hey Axon" / "Hello Axon" /
# "Hi Axon", entirely on this machine. While Axon is armed and waiting for that
# phrase, audio reaches a local process and nothing else — no socket exists
# until you activate a session.
AXON_WAKE_ENGINE=keyword

# The keyword spotter's detection threshold. Leave unset: the default was
# measured, and `docs/wake-word.md` carries the table. This exists so
# `npm run wake:calibrate` can sweep it without a rebuild.
AXON_WAKE_THRESHOLD=

# Development builds only. Numeric voice-path diagnostics to the developer
# console: the capture page's real sample rate and pipeline, whether it is
# producing real-time audio, frames reaching main, audio sent to AssemblyAI and
# its cadence, and AssemblyAI's partial and final transcripts. Never audio.
# AXON_VOICE_DEBUG=1

# Push-to-talk shortcut. Optional; must include at least one modifier.
# Axon tries this first and falls back to Control+Shift+Space,
# Control+Alt+Space, then Control+Shift+F9 if another application owns it.
# With none available, the on-screen "Talk to Axon" button still works.
AXON_VOICE_HOTKEY=

# --- Runtime ---------------------------------------------------------------
# Root for the agent workspace, screenshots and event logs.
# Defaults to <home>/Axon when unset.
AXON_HOME=

# Approval prompts auto-deny after this many milliseconds (deny-by-default).
AXON_APPROVAL_TIMEOUT_MS=60000
